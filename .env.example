# Copy to .env (git-ignored) or set the same names in
# Vercel → Project → Settings → Environment Variables, then rebuild.

# The deployed origin, no trailing slash. Used for canonical, og:url, og:image,
# robots.txt's Sitemap line and every URL in sitemap.xml.
# Until this is set, those files say https://REPLACE-WITH-YOUR-DOMAIN
# and the build prints a warning.
#   production : https://your-domain.com        (or https://<project>.vercel.app)
#   preview    : https://<project>-git-branch.vercel.app
VITE_SITE_ORIGIN=

# Where the contact form posts. Leave empty to use the FormSubmit alias baked into
# src/sections/Contact.jsx (the mailbox address is deliberately not in this repo).
# Only set this to point a staging build at a different destination.
#   e.g. https://formsubmit.co/ajax/<another-alias>
VITE_CONTACT_ENDPOINT=
